    "Shows how many stops are left until you get off.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukazuje, kolik stanic zbývá do výstupu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser, hvor mange stationer der er tilbage, før du skal af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, wie viele Stationen es noch bis zum Aussteigen sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείχνει πόσες στάσεις μένουν μέχρι να κατεβείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how many stops are left until you get off."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how many stops are left until you get off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cuántas paradas faltan hasta donde te bajas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää, montako asemaa on jäljellä ennen kuin jäät pois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique combien d’arrêts il reste avant de descendre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan berapa stasiun lagi sampai kamu turun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quante fermate mancano prima di scendere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "降りる駅まであと何駅かを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내릴 역까지 몇 정거장 남았는지 보여 줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser hvor mange stasjoner det er igjen til du skal av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat zien hoeveel haltes je nog hebt tot je uitstapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje, ile stacji zostało do wysiadki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quantas estações faltam até você descer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает, сколько станций осталось до выхода."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar hur många stationer det är kvar tills du ska av."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกว่าเหลืออีกกี่สถานีก่อนถึงสถานีที่ต้องลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İneceğin yere kaç durak kaldığını gösterir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho biết còn bao nhiêu ga nữa thì đến chỗ xuống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示距离下车站还有几站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示距離下車站還有幾站。"
          }
        }
      }
    },
