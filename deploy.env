# DeployBar 배포 설정 - 이 파일이 이 앱의 배포 규칙 전부다.
# 참고: DeployBar/README.md 의 "앱 쪽 규칙" 표

# 필수: archive 할 scheme (위젯은 앱에 임베드되어 함께 올라간다)
SCHEME=KORA

# 플랫폼 (ios | macos)
PLATFORM=ios

# 버전·빌드번호의 단일 소스. 앱·위젯 두 타겟이 모두 이 파일을 base 로 쓴다.
VERSION_XCCONFIG=KORA/Config/Version.xcconfig

# 배포 전 게이트. 실패하면 아카이브를 만들지 않는다.
PREDEPLOY_SCRIPT=scripts/predeploy.sh

# 다국어: App Store 에 등록한 언어. 이 목록이 곧
#   (1) 다국어 게이트의 검사 기준이고
#   (2) 릴리즈노트를 만들 언어다 (RELEASE_NOTES.md 의 절과 같아야 한다).
# 기본 언어는 일본어다 (project.pbxproj 의 developmentRegion = ja).
LOCALES=ja,ko,en-US,zh-Hans,zh-Hant

# 다국어 게이트 강도 - 카탈로그(InfoPlist·위젯)는 다섯 언어가 다 차 있어야 한다.
# 화면 문구는 카탈로그가 아니라 코드(NavLoc)에 있고, 빈칸은 컴파일러가 막는다.
LOCALIZATION_GATE=strict

# 릴리즈노트 게이트 - '이 버전의 새로운 기능' 이 비어 있으면 배포 중단.
RELEASE_NOTES_GATE=strict
