// Template for KORA/Config/Secrets.xcconfig (which is gitignored).
//
// 1. Copy this file to Secrets.xcconfig in the same directory.
// 2. Fill in your own developer keys.
// 3. Build — the values are injected into Info.plist via $(...) substitution
//    and read at runtime from Bundle.main.

KAKAO_REST_API_KEY = YOUR_KAKAO_REST_API_KEY
NAVER_CLIENT_ID = YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET = YOUR_NAVER_CLIENT_SECRET

// 서울 열린데이터광장 실시간 지하철 도착 API 키 (http://data.seoul.go.kr).
// 비워두면 실시간 출발·정차 보정이 꺼지고 GPS/가속도계/시간 추정만 사용합니다.
SEOUL_OPEN_API_KEY = YOUR_SEOUL_OPEN_API_KEY
