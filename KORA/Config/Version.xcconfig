//
//  Version.xcconfig
//  KORA
//
//  버전·빌드번호가 사는 단 한 곳. 앱과 위젯 두 타겟이 모두 이 파일을 base 로 쓴다.
//  DeployBar 가 배포할 때 여기 숫자를 올린다 (deploy.env 의 VERSION_XCCONFIG).
//
//  ⚠️ Xcode 타겟 > General 의 Version·Build 칸을 고치면 project.pbxproj 에
//     같은 키가 다시 적혀 이 파일을 이겨 버린다. scripts/predeploy.sh 가 그걸 막는다.
//

// 앱 버전 (App Store 에 보이는 번호)
MARKETING_VERSION = 1.0.5

// 빌드 번호 (업로드마다 올린다)
CURRENT_PROJECT_VERSION = 6

// API 키 (gitignore 된 파일 — 없어도 빌드는 된다. 실시간 도착 정보만 꺼진다)
#include? "Secrets.xcconfig"
